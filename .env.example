# Copy to .env to override defaults. All variables are prefixed with APP_
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
# APP_BOOKS_CSV_PATH=data/books.csv

# --- AI assistant ---
APP_OPENAI_API_KEY=
